# Cloudflare Pages only (Vercel ignores this file and uses vercel.json).
# Keep these values in sync with the "headers" block in vercel.json.
# If the Render API URL or any external host changes, update connect-src below AND in vercel.json.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://spice-garden-efm8.onrender.com wss://spice-garden-efm8.onrender.com; frame-src https://www.google.com; base-uri 'self'; form-action 'self'

# Vite emits content-hashed files into /assets, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# OPTIONAL - uncomment once you attach a custom domain to this Cloudflare project.
# It keeps the free *.pages.dev address out of search results so it never
# competes with the real domain. It matches the pages.dev host only, so the
# custom domain is unaffected. (Do NOT enable it while pages.dev is your only URL.)
# https://:project.pages.dev/*
#   X-Robots-Tag: noindex